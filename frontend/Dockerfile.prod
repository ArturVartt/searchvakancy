# Multi-stage: собираем статику Vite-сборкой, отдаём через nginx.
FROM node:20-alpine AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

COPY . .
# Пусто = относительные пути к API/WS, тот же origin (см. nginx.conf.template) —
# сознательно НЕ читаем .env здесь, прод не должен зависеть от дев-настроек.
ENV VITE_API_BASE_URL=""
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
# nginx сам прогонит envsubst по *.template -> conf.d/*.conf при старте
# контейнера (встроенный docker-entrypoint.d/20-envsubst-on-templates.sh),
# подставив $DOMAIN из окружения контейнера — см. docker-compose.prod.yml.
COPY nginx.conf.template /etc/nginx/templates/default.conf.template

EXPOSE 80 443
