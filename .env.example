# Скопируйте этот файл в .env и заполните под себя:
#   cp .env.example .env

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev
LOG_LEVEL=INFO

# --- Postgres ---
POSTGRES_DB=searchvakancy
POSTGRES_USER=searchvakancy
POSTGRES_PASSWORD=searchvakancy
DATABASE_URL=postgres://searchvakancy:searchvakancy@db:5432/searchvakancy

# --- Redis / Celery / Channels ---
REDIS_URL=redis://redis:6379/0

# --- CORS (frontend dev server) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Telegram bot (Phase 3) ---
TELEGRAM_BOT_TOKEN=

# --- SuperJob API (https://api.superjob.ru/register/) ---
SUPERJOB_API_KEY=
