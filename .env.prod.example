# Скопируйте в .env.prod и заполните реальными значениями перед деплоем:
#   cp .env.prod.example .env.prod
# Используется docker-compose.prod.yml и init-letsencrypt.sh.

# --- Домен (обязательно) ---
# DNS A-запись должна уже указывать на этот сервер — на неё будет выпущен
# TLS-сертификат Let's Encrypt (см. init-letsencrypt.sh).
DOMAIN=your-domain.example
# Опционально — Let's Encrypt пришлёт сюда предупреждение об истечении
# сертификата (не критично: автопродление и так настроено в docker-compose.prod.yml).
LETSENCRYPT_EMAIL=

# --- Django (обязательно) ---
DJANGO_SECRET_KEY=REPLACE_ME_use_a_long_random_value
DJANGO_ALLOWED_HOSTS=your-domain.example
DJANGO_SECURE_SSL_REDIRECT=True
LOG_LEVEL=INFO

# --- Postgres (обязательно) ---
POSTGRES_DB=searchvakancy
POSTGRES_USER=searchvakancy
POSTGRES_PASSWORD=REPLACE_ME_use_a_strong_password

# --- Telegram bot (опционально — без него просто не поднимайте сервис telegram_bot) ---
TELEGRAM_BOT_TOKEN=

# --- SuperJob API (https://api.superjob.ru/register/) ---
SUPERJOB_API_KEY=

# --- Порты, на которых nginx (фронтенд) слушает снаружи ---
HTTP_PORT=80
HTTPS_PORT=443
